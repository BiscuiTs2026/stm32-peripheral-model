# 四层角色映射，供 firmware-four-layer-architecture 的 check_layering.py 使用。
# 语法：<模式> = <角色>；模式含 "/" 时匹配相对路径，不含 "/" 时只匹配文件名。
# 依赖方向：app → components → osal → bsp；glue 只做初始化与中断分发。

# 第三方与构建产物：不参与分层判定。
# third_party/ 是 CMSIS 与 ST HAL 子集，属于厂商代码，忽略而不是映射成 bsp
# （上游 docs/integration.md 第 5 节：映射成 bsp 会导致每次解析整套厂商包）。
ignore = third_party/
ignore = build-*/

# 各层自己的公共接口头，归各自层（否则实现方 include 自己的接口会被判成越层）
include/pm/pm_osal.h = osal
include/pm/pm_port.h = bsp

# 纯类型与错误码（err_t、公共枚举），任何层可包含
include/pm/pm_common.h = common
include/pm/pm_err.h    = common

# common = 与硬件无关的纯逻辑：错误码、定点/数学运算、资源占用仲裁。
# 不得包含寄存器访问、HAL 调用、任何厂商头，以及任何针对具体外设的行为。
# 方向：任何层可依赖 common，common 不依赖任何层。
# 端口在写定时器寄存器前必须直调这些函数（PSC/ARR 规则只有一份实现），
# 所以它们不能归 components，否则 bsp 就成了反向依赖。
include/pm/pm_pwm_math.h = common
include/pm/pm_timer.h    = common
src/common/*             = common

# 组件层公共契约 + 与硬件无关的模型
include/pm/*        = components
src/core/*          = components

# 时基与临界区
src/osal/*          = osal

# 芯片后端：HAL 胶水、ISR、pm_port_get() 的 F1 实现
src/port/stm32f1/*  = bsp

# 板级引脚表、启动文件、链接脚本、HAL 配置、演示入口
platform/*          = glue
src/app/main.c      = glue

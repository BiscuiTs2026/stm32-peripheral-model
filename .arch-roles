# 四层角色映射，供 firmware-four-layer-architecture 的 check_layering.py 使用。
# 语法：<模式> = <角色>；模式含 "/" 时匹配相对路径，不含 "/" 时只匹配文件名。
# 依赖方向：app → components → osal → bsp；glue 只做初始化与中断分发。

# 各层自己的公共接口头，归各自层（否则实现方 include 自己的接口会被判成越层）
include/pm/pm_osal.h = osal
include/pm/pm_port.h = bsp

# 纯类型与错误码（err_t、公共枚举），任何层可包含
include/pm/pm_common.h = common
include/pm/pm_err.h    = common

# 组件层公共契约 + 与硬件无关的模型
include/pm/*        = components
src/core/*          = components

# 时基与临界区
src/osal/*          = osal

# 芯片后端：HAL 胶水、ISR、pm_port_get() 的 F1 实现
src/port/stm32f1/*  = bsp

# 板级引脚表、启动文件、链接脚本、HAL 配置、演示入口
platform/*          = glue
src/app/main.c      = glue

# 第三方厂商代码不参与应用分层，按最底层 bsp 处理，
# 避免把 CMSIS/HAL 自身当成"上层代码"审查。
third_party/*       = bsp
